// This is your Prisma schema file for SIJAYA GasFlow
// Run: npx prisma generate && npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  STAFF
  DRIVER
  CUSTOMER
}

enum CustomerType {
  DOMESTIC
  COMMERCIAL
  BULK
  INSTITUTIONAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SCHEDULED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

enum DeliveryStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum LoadStatus {
  DRAFT
  DISPATCHED
  IN_TRANSIT
  ARRIVED
  UNDER_INSPECTION
  APPROVED
  REJECTED
}

enum StockMovementType {
  LOAD_IN
  ORDER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGED
  RETURNED
  RESERVED
  RESERVE_RELEASED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  OTHER
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
  OVERDUE
  WAIVED
}

enum CylinderStatus {
  AVAILABLE
  DEPLOYED
  EMPTY_RETURNED
  IN_MAINTENANCE
  DAMAGED
  RETIRED
}

enum SubscriptionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum ProductUnit {
  CYLINDER_14KG
  CYLINDER_19KG
  CYLINDER_5KG
  KG
  LITRE
}

// ─────────────────────────────────────────────
// USERS & ROLES
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  customer     Customer?
  staff        Staff?
  sessions     Session[]
  auditLogs    AuditLog[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
}

// ─────────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────────

model Customer {
  id               String       @id @default(uuid())
  userId           String       @unique
  customerCode     String       @unique
  name             String
  businessName     String?
  phone            String
  email            String?
  customerType     CustomerType @default(DOMESTIC)
  isActive         Boolean      @default(true)
  notes            String?
  registeredAt     DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  user             User         @relation(fields: [userId], references: [id])
  addresses        CustomerAddress[]
  orders           Order[]
  creditAccount    CreditAccount?
  payments         Payment[]
  quotations       Quotation[]
  subscriptions    Subscription[]
  consumptions     ConsumptionRecord[]

  @@index([customerType])
  @@index([customerCode])
}

model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String
  label        String   @default("Home")
  addressLine1 String
  addressLine2 String?
  city         String
  district     String?
  state        String   @default("Tamil Nadu")
  pincode      String?
  landmark     String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer  @relation(fields: [customerId], references: [id])
  deliveries   Delivery[]

  @@index([customerId])
}

// ─────────────────────────────────────────────
// STAFF & DRIVERS
// ─────────────────────────────────────────────

model Staff {
  id           String   @id @default(uuid())
  userId       String   @unique
  employeeCode String   @unique
  name         String
  phone        String
  role         Role
  isActive     Boolean  @default(true)
  joinedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User       @relation(fields: [userId], references: [id])
  deliveries   Delivery[]

  @@index([role])
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id            String      @id @default(uuid())
  name          String
  nameTamil     String?
  description   String?
  unit          ProductUnit
  isActive      Boolean     @default(true)
  displayOrder  Int         @default(0)
  imageUrl      String?
  specifications Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orderItems        OrderItem[]
  quotationItems    QuotationItem[]
  inventoryRecords  Inventory[]
  cylinderAssets    CylinderAsset[]
  stockMovements    StockMovement[]
  loadItems         GasLoadItem[]

  @@index([unit])
}

// ─────────────────────────────────────────────
// SUPPLIER
// ─────────────────────────────────────────────

model Supplier {
  id           String   @id @default(uuid())
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gasLoads     GasLoad[]
}

// ─────────────────────────────────────────────
// GAS LOADS (Incoming)
// ─────────────────────────────────────────────

model GasLoad {
  id                String     @id @default(uuid())
  loadCode          String     @unique
  supplierId        String
  dispatchDate      DateTime?
  expectedArrival   DateTime?
  actualArrival     DateTime?
  vehicleNumber     String?
  invoiceReference  String?
  status            LoadStatus @default(DRAFT)
  notes             String?
  approvedById      String?
  approvedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  supplier          Supplier   @relation(fields: [supplierId], references: [id])
  items             GasLoadItem[]
  stockMovements    StockMovement[]

  @@index([status])
  @@index([supplierId])
}

model GasLoadItem {
  id               String   @id @default(uuid())
  gasLoadId        String
  productId        String
  expectedQty      Decimal  @db.Decimal(10, 3)
  receivedQty      Decimal  @db.Decimal(10, 3) @default(0)
  damagedQty       Decimal  @db.Decimal(10, 3) @default(0)
  missingQty       Decimal  @db.Decimal(10, 3) @default(0)
  excessQty        Decimal  @db.Decimal(10, 3) @default(0)
  notes            String?

  gasLoad          GasLoad  @relation(fields: [gasLoadId], references: [id])
  product          Product  @relation(fields: [productId], references: [id])
}

// ─────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────

model Inventory {
  id              String   @id @default(uuid())
  productId       String   @unique
  availableQty    Decimal  @db.Decimal(10, 3) @default(0)
  reservedQty     Decimal  @db.Decimal(10, 3) @default(0)
  damagedQty      Decimal  @db.Decimal(10, 3) @default(0)
  updatedAt       DateTime @updatedAt

  product         Product  @relation(fields: [productId], references: [id])

  @@index([productId])
}

model StockMovement {
  id            String            @id @default(uuid())
  productId     String
  movementType  StockMovementType
  quantity      Decimal           @db.Decimal(10, 3)
  balanceAfter  Decimal           @db.Decimal(10, 3)
  referenceType String?           // "ORDER", "LOAD", "ADJUSTMENT", etc.
  referenceId   String?
  gasLoadId     String?
  notes         String?
  performedById String?
  createdAt     DateTime          @default(now())

  product       Product   @relation(fields: [productId], references: [id])
  gasLoad       GasLoad?  @relation(fields: [gasLoadId], references: [id])

  @@index([productId])
  @@index([movementType])
  @@index([referenceType, referenceId])
}

// ─────────────────────────────────────────────
// CYLINDER ASSETS
// ─────────────────────────────────────────────

model CylinderAsset {
  id               String         @id @default(uuid())
  serialNumber     String         @unique
  productId        String
  status           CylinderStatus @default(AVAILABLE)
  assignedCustomerId String?
  location         String?
  issueDate        DateTime?
  returnDate       DateTime?
  lastInspectedAt  DateTime?
  maintenanceNotes String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  product          Product  @relation(fields: [productId], references: [id])

  @@index([status])
  @@index([productId])
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id               String      @id @default(uuid())
  orderCode        String      @unique
  customerId       String
  status           OrderStatus @default(PENDING)
  orderType        CustomerType @default(DOMESTIC)
  notes            String?
  deliveryNotes    String?
  totalAmount      Decimal     @db.Decimal(12, 2) @default(0)
  taxAmount        Decimal     @db.Decimal(12, 2) @default(0)
  discountAmount   Decimal     @db.Decimal(12, 2) @default(0)
  netAmount        Decimal     @db.Decimal(12, 2) @default(0)
  quotationId      String?
  subscriptionId   String?
  approvedById     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  customer         Customer    @relation(fields: [customerId], references: [id])
  quotation        Quotation?  @relation(fields: [quotationId], references: [id])
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])
  items            OrderItem[]
  delivery         Delivery?
  invoice          Invoice?
  payments         Payment[]

  @@index([customerId])
  @@index([status])
  @@index([orderCode])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  quantity    Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(10, 2)
  taxRate     Decimal  @db.Decimal(5, 2) @default(0)
  lineTotal   Decimal  @db.Decimal(12, 2)

  order       Order    @relation(fields: [orderId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}

// ─────────────────────────────────────────────
// SUBSCRIPTIONS
// ─────────────────────────────────────────────

model Subscription {
  id              String                @id @default(uuid())
  customerId      String
  productId       String?
  frequency       SubscriptionFrequency
  status          SubscriptionStatus    @default(ACTIVE)
  nextExpectedDate DateTime?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  customer        Customer  @relation(fields: [customerId], references: [id])
  orders          Order[]
  schedules       SubscriptionSchedule[]

  @@index([customerId])
  @@index([status])
}

model SubscriptionSchedule {
  id             String   @id @default(uuid())
  subscriptionId String
  scheduledDate  DateTime
  orderId        String?
  fulfilled      Boolean  @default(false)
  createdAt      DateTime @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

// ─────────────────────────────────────────────
// CREDIT ACCOUNTS
// ─────────────────────────────────────────────

model CreditAccount {
  id              String   @id @default(uuid())
  customerId      String   @unique
  creditLimit     Decimal  @db.Decimal(12, 2) @default(0)
  outstandingBalance Decimal @db.Decimal(12, 2) @default(0)
  approvedById    String?
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer @relation(fields: [customerId], references: [id])
}

// ─────────────────────────────────────────────
// QUOTATIONS
// ─────────────────────────────────────────────

model Quotation {
  id               String          @id @default(uuid())
  quotationCode    String          @unique
  customerId       String
  status           QuotationStatus @default(DRAFT)
  validUntil       DateTime?
  notes            String?
  termsConditions  String?
  totalAmount      Decimal         @db.Decimal(12, 2) @default(0)
  taxAmount        Decimal         @db.Decimal(12, 2) @default(0)
  netAmount        Decimal         @db.Decimal(12, 2) @default(0)
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  customer         Customer        @relation(fields: [customerId], references: [id])
  items            QuotationItem[]
  orders           Order[]

  @@index([customerId])
  @@index([status])
}

model QuotationItem {
  id              String   @id @default(uuid())
  quotationId     String
  productId       String
  quantity        Decimal  @db.Decimal(10, 3)
  unitPrice       Decimal  @db.Decimal(10, 2)
  taxRate         Decimal  @db.Decimal(5, 2) @default(0)
  additionalCharges Decimal @db.Decimal(10, 2) @default(0)
  lineTotal       Decimal  @db.Decimal(12, 2)
  notes           String?

  quotation       Quotation @relation(fields: [quotationId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])
}

// ─────────────────────────────────────────────
// DELIVERIES
// ─────────────────────────────────────────────

model Delivery {
  id               String         @id @default(uuid())
  deliveryCode     String         @unique
  orderId          String         @unique
  driverId         String?
  addressId        String?
  status           DeliveryStatus @default(PENDING)
  scheduledDate    DateTime?
  scheduledTimeSlot String?
  actualDeliveredAt DateTime?
  vehicleNumber    String?
  deliveryNotes    String?
  failureReason    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order            Order          @relation(fields: [orderId], references: [id])
  driver           Staff?         @relation(fields: [driverId], references: [id])
  address          CustomerAddress? @relation(fields: [addressId], references: [id])
  proof            DeliveryProof?

  @@index([driverId])
  @@index([status])
  @@index([scheduledDate])
}

model DeliveryProof {
  id           String   @id @default(uuid())
  deliveryId   String   @unique
  photoUrl     String?
  signature    String?
  receiverName String?
  notes        String?
  recordedAt   DateTime @default(now())

  delivery     Delivery @relation(fields: [deliveryId], references: [id])
}

// ─────────────────────────────────────────────
// CONSUMPTION RECORDS
// ─────────────────────────────────────────────

model ConsumptionRecord {
  id           String   @id @default(uuid())
  customerId   String
  productId    String?
  periodStart  DateTime
  periodEnd    DateTime
  quantityDelivered Decimal @db.Decimal(10, 3)
  notes        String?
  createdAt    DateTime @default(now())

  customer     Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

// ─────────────────────────────────────────────
// PAYMENTS & INVOICES
// ─────────────────────────────────────────────

model Invoice {
  id              String   @id @default(uuid())
  invoiceCode     String   @unique
  orderId         String   @unique
  totalAmount     Decimal  @db.Decimal(12, 2)
  taxAmount       Decimal  @db.Decimal(12, 2) @default(0)
  netAmount       Decimal  @db.Decimal(12, 2)
  pdfUrl          String?
  issuedAt        DateTime @default(now())
  dueDate         DateTime?
  createdById     String?
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id])
  payments        Payment[]

  @@index([orderId])
}

model Payment {
  id              String        @id @default(uuid())
  paymentCode     String        @unique
  customerId      String
  orderId         String?
  invoiceId       String?
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod @default(CASH)
  status          PaymentStatus @default(PAID)
  reference       String?
  paidAt          DateTime?
  notes           String?
  recordedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer        Customer      @relation(fields: [customerId], references: [id])
  order           Order?        @relation(fields: [orderId], references: [id])
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([customerId])
  @@index([status])
}

// ─────────────────────────────────────────────
// BRANDS (Homepage Carousel)
// ─────────────────────────────────────────────

model Brand {
  id           String   @id @default(uuid())
  nameEnglish  String
  nameTamil    String?
  logoUrl      String?
  category     String?
  displayOrder Int      @default(0)
  isApproved   Boolean  @default(false)
  isVisible    Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isApproved, isVisible])
}

// ─────────────────────────────────────────────
// WEBSITE CONTENT
// ─────────────────────────────────────────────

model WebsiteContent {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String?
  content     String?
  contentJson Json?
  imageUrl    String?
  isActive    Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  message     String
  type        String   @default("INFO")
  isRead      Boolean  @default(false)
  referenceId String?
  referenceType String?
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  entityType   String?
  entityId     String?
  previousData Json?
  newData      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

