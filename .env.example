# ============================================================
# SIJAYA GasFlow — Environment Variables Template
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sijaya_gasflow"

# --- API Server ---
API_PORT=4000
NODE_ENV=development

# --- Auth (generate strong random secrets) ---
JWT_SECRET=your-jwt-secret-minimum-64-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your-cookie-secret-minimum-32-chars

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- File uploads ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# --- Email (optional — for notifications) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# --- Future: Payment Gateway ---
# Configure here when approved

